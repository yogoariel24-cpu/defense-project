{
	"info": {
		"_postman_id": "vigilis-intelligent-house-api-v2",
		"name": "Vigilis Intelligent House System API (Complete)",
		"description": "Comprehensive Postman collection for testing all REST endpoints including Auth, Payments, Platform Admin, Smart Lighting, AI Security, Emergency System, Devices, and Residents.",
